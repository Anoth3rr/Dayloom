# Only application source, required assets, and build configuration belong here.
/*
!/.gitignore
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/electron/
!/shared/
!/src/
!/scripts/
!/public/
!/build/

/build/*
!/build/icon.ico
!/build/icon.png

# Exclude local artifacts even when generated inside a source directory.
node_modules/
dist/
release/
.vite/
.cache/
.idea/
.vscode/
docs/
tests/
__tests__/
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/
verification/
qa/
reports/
plans/
backups/
*.md
*.log
*.tsbuildinfo
*.map
*.test.*
*.spec.*
*-smoke.*
*.zip
*.7z
*.exe
*.lnk
*.bak
*.backup
*.sqlite*
*.db

# Local configuration and credentials.
.env
.env.*
.npmrc
*.local.*
*.pem
*.key
*.p12
*.pfx
*.jks
