# Keep application source, required assets, build configuration, and the README.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/config/
!/assets/
!/src/
!/scripts/

# Exclude local artifacts even when generated inside a source directory.
node_modules/
dist/
release/
.vite/
.cache/
.idea/
.vscode/
docs/
tests/
__tests__/
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/
verification/
qa/
reports/
plans/
backups/
*.md
!/README.md
*.log
*.tsbuildinfo
*.map
*.test.*
*.spec.*
*-smoke.*
*.zip
*.7z
*.exe
*.lnk
*.bak
*.backup
*.sqlite*
*.db

# Local configuration and credentials.
.env
.env.*
.npmrc
*.local.*
*.pem
*.key
*.p12
*.pfx
*.jks
