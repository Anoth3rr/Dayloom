{
  "name": "shixu-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Dayloom · 拾序 — 任务与日程桌面应用",
  "author": "Shixu",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "desktop:dev": "node scripts/dev.mjs",
    "build": "tsc --project src/tsconfig.json && vite build --config config/vite.config.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --config config/electron-builder.json --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
